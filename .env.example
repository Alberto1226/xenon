# Variables de entorno de la integración con CoreCFDI (descarga de CFDI del SAT).
# Este proyecto no carga archivos .env: defina estas variables en el entorno del proceso de Node
# (igual que DB, PORT y APP_SECRET).
#
# La empresa (tenant), el email y la contraseña NO van aquí: cada usuario los escribe al iniciar
# sesión en CoreCFDI desde la pantalla.

# URL base de la API. El valor de abajo es de ejemplo; mientras siga puesto, la integración
# responde "no está configurada".
CORECFDI_BASE_URL=https://mi-dominio.com/api/v1

# Opcional: nombre con el que este sistema se identifica al iniciar sesión (por defecto "xenon").
CORECFDI_DEVICE_NAME=xenon
